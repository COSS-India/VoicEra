# nees-demo model stack -> copy to model-server/.env in the demo checkout.
#
# A second model-server beside production's on ace-h200, sharing nothing but
# GPU 1 (through the existing MPS daemon). Different project, container names,
# network, HF cache volume and port.

COMPOSE_PROJECT_NAME=voicera-nees-demo-models
MODEL_CONTAINER_PREFIX=nees_demo_model
# Loopback only. The demo app stack reaches the gateway over Docker's network,
# not this port; it exists for curl and smoke tests on the box.
GATEWAY_PORT=127.0.0.1:8400

COMPOSE_PROFILES=stt,tts
STT_MODEL=pt-whisper
TTS_MODEL=pt-chatterbox
LLM_MODEL=

# GPU 1 is the only card this team may use. It runs in Exclusive Process mode
# behind an MPS daemon; compose-files.sh detects the daemon and layers in
# compose.mps.yml plus each model's own compose.mps.yml (memory + SM caps).
GPU_DEVICE_IDS=1
# Set this to the pipe directory production's model containers mount -- the
# runbook's step 0 shows how to read it. /tmp/nvidia-mps-gpu1 is the convention.
MPS_PIPE_DIR=/tmp/nvidia-mps-gpu1

# Per-container caps on the shared card. MPS hard limit first, PyTorch a little
# under it so PyTorch fails cleanly before MPS does.
PTW_MPS_MEM_LIMIT=6G
PTW_CUDA_MEM_GB=5
PTW_MPS_THREAD_PCT=25
PTC_MPS_MEM_LIMIT=8G
PTC_CUDA_MEM_GB=7
PTC_MPS_THREAD_PCT=25

# Neither model needs a token (both public), nor the NeMo fork. Compose still
# stats every declared build context, so point it at an empty folder that
# exists: `mkdir -p model-server/.nemo-context`. Relative to model-server/.
NEMO_CONTEXT_PATH=./.nemo-context
HF_TOKEN=
