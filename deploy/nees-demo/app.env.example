# nees-demo app stack -> copy to .env at the root of the demo checkout.
#
# Same variables as the repo's .env.example; the differences are the block at
# the top. Generate fresh secrets -- never reuse production's.

# ---- what makes this a separate stack -------------------------------------
COMPOSE_PROJECT_NAME=voicera-nees-demo
CONTAINER_PREFIX=nees_demo
# Loopback only; the public way in is the Cloudflare tunnel.
FRONTEND_HOST_PORT=127.0.0.1:3300
API_HOST_PORT=127.0.0.1:8300
RUNTIME_HOST_PORT=127.0.0.1:7960
MINIO_API_PORT=127.0.0.1:9300
MINIO_CONSOLE_PORT=127.0.0.1:9301
FERRETDB_HOST_PORT=127.0.0.1:27318
# The demo model gateway, by container name on the shared Docker network
# (deploy/nees-demo/compose.app.yml joins it). Never production's :8100.
MODEL_SERVER_URL=http://nees_demo_model_gateway:8000/v1
MODEL_SERVER_WS_URL=ws://nees_demo_model_gateway:8000/v1/asr/ws

# ---- secrets: generate, do not copy ---------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
INTERNAL_API_KEY=
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PROVIDER_AUTH_ENCRYPTION_KEY=

# ---- the rest, as in the repo's .env.example --------------------------------
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=
DEBUG=False
PROJECT_NAME=Voicera API
VERSION=0.1.0
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
# Set to the tunnel URL once you have it (only used in password-reset emails).
FRONTEND_URL=http://localhost:3300
VOICE_SERVER_BASE_URL=
API_BASE_URL=http://localhost:8000/api/v1
SAMPLE_RATE=8000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=voicera-calls
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
CHROMA_BASE_DIR=app/rag/chroma_data
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=text-embedding-3-small
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@localhost:6379
CAMPAIGN_BATCH_SIZE=10
DEFAULT_ORG_CONCURRENCY_LIMIT=10
ALLOWED_DEV_ORIGINS=
