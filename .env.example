# Mongo-compatible DB via FerretDB (PostgreSQL + DocumentDB under the hood).
# In Docker Compose use MONGODB_HOST=mongodb (network alias for ferretdb).
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=

# Application
DEBUG=False
PROJECT_NAME=Voicera API
VERSION=0.1.0

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=Fn_VXROYOWm4_3l9BwNhZt2bcGezdHS8DIsnu8at_fc
INTERNAL_API_KEY=7kgsAkJGW48ddKTgDrpQPbMIP8gnJTqVzyKRJDQ5_Kg

# Password-reset email (Mailtrap)
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000
FERRETDB_HOST_PORT=27018
API_HOST_PORT=8000
RUNTIME_HOST_PORT=7860
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_AUTH_ENCRYPTION_KEY=4t5NMi97Y9DhB_Vc12Vn8q6SDdUhDTR4GeaJyLm_E1w=
VOICE_SERVER_BASE_URL=https://vobiz.johnaic.com

# --- Sandbox onboarding (see docs/developer/sandbox-onboarding-plan.md) ---
# Credentials the platform supplies when an org has not connected a provider
# itself. JSON: provider id → secret fields. Empty disables the fallback.
# Telephony providers are never resolved from here.
# Set this together with RATE_LIMIT_ENABLED=True — it is what bounds the spend.
PLATFORM_PROVIDER_AUTH=
# Seed the demo agents in apps/api/app/seed/default_agents.json into every new org.
SANDBOX_SEED_AGENTS=True

# --- Runtime (apps/runtime) ---
API_BASE_URL=http://localhost:8000/api/v1
SAMPLE_RATE=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=voicera-calls
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# Knowledge base (Chroma + embeddings; API only)
CHROMA_BASE_DIR=app/rag/chroma_data
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=text-embedding-3-small

# Redis (ARQ job queue + campaign pub/sub)
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@localhost:6379
CAMPAIGN_BATCH_SIZE=10
DEFAULT_ORG_CONCURRENCY_LIMIT=10

# Rate limiting and abuse control (see docs/developer/rate-limiting-plan.md)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_FAIL_OPEN=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RATE_LIMIT_IP_SALT=
TRUST_PROXY_HEADERS=False
# Measure against the real deployment before enabling — see plan §7.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_IP_ALLOWLIST=
RATE_LIMIT_SCOPE_STALE_SECONDS=900
SIGNUP_ORGS_PER_IP_PER_HOUR=2
SIGNUP_ORGS_PER_IP_PER_DAY=5
SIGNUP_ATTEMPTS_PER_IP_PER_HOUR=10
AUTH_ATTEMPTS_PER_IP_PER_MINUTE=10
RESET_MAILS_PER_EMAIL_PER_HOUR=3
MAX_CONCURRENT_CALLS_PER_IP=5
ORG_DAILY_CALL_SECONDS=14400
MAX_CALL_DURATION_SECONDS=600
MAX_CALL_DURATION_CEILING_SECONDS=1800
# Dedicated key for the runtime WebSocket admission token (Layer 2b) — must
# NOT reuse SECRET_KEY. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNTIME_SESSION_SECRET=

# Comma-separated hostnames allowed as Next.js allowedDevOrigins (no scheme).
ALLOWED_DEV_ORIGINS=voicera.johnaic.com

# Browser test-call WebSocket is proxied same-origin (/agent/* → runtime:7860).
# Only port 3000 needs to be public — no separate runtime URL or ngrok on 7860.
