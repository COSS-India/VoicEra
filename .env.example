# Mongo-compatible DB via FerretDB (PostgreSQL + DocumentDB under the hood).
# In Docker Compose use MONGODB_HOST=mongodb (network alias for ferretdb).
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USER=admin
# Left blank on purpose: start-application-services.sh generates a random password
# on first run. Also becomes POSTGRES_PASSWORD, which Postgres only applies when its
# data volume is first created -- so never change it on an existing install.
MONGODB_PASSWORD=
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=

# Application
DEBUG=False
PROJECT_NAME=Voicera API
VERSION=0.1.0

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left blank on purpose: start-application-services.sh generates each one on first run.
# Use a different value for each; never commit real values to this file.
SECRET_KEY=
INTERNAL_API_KEY=

# Password-reset email (Mailtrap)
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000
FERRETDB_HOST_PORT=27018
API_HOST_PORT=8000
RUNTIME_HOST_PORT=7860
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_AUTH_ENCRYPTION_KEY=
VOICE_SERVER_BASE_URL=https://vobiz.johnaic.com

# --- Runtime (apps/runtime) ---
API_BASE_URL=http://localhost:8000/api/v1
SAMPLE_RATE=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
# Left blank on purpose: generated on first run. MINIO_SECRET_KEY must equal it.
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=voicera-calls
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_SECURE=false

# Knowledge base (Chroma + embeddings; API only)
CHROMA_BASE_DIR=app/rag/chroma_data
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=text-embedding-3-small

# Redis (ARQ job queue + campaign pub/sub)
# Left blank on purpose: generated on first run, and REDIS_URL is built from it
# (redis://:<REDIS_PASSWORD>@localhost:6379).
REDIS_PASSWORD=
REDIS_URL=
CAMPAIGN_BATCH_SIZE=10
DEFAULT_ORG_CONCURRENCY_LIMIT=10

# Audit log. Retention minimum is 365 days (DPDP Rules 2025).
# EVENTLOG_RETENTION_DAYS=365
# EVENTLOG_WRITE_TIMEOUT_MS=500
# EVENTLOG_EXPORT_MAX_ROWS=100000
# Proxies trusted to set X-Forwarded-For, so audit events record the real client IP.
# See docs/guides/deployment/security-hardening.md.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Comma-separated hostnames allowed as Next.js allowedDevOrigins (no scheme).
ALLOWED_DEV_ORIGINS=voicera.johnaic.com

# Browser test-call WebSocket is proxied same-origin (/agent/* → runtime:7860).
# Only port 3000 needs to be public — no separate runtime URL or ngrok on 7860.


