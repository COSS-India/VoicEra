FROM node:24-slim

WORKDIR /app

COPY package.json package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --omit=dev

COPY . .

# NEXT_PUBLIC_* are inlined at build time; proxy targets are read at runtime in next.config.ts.
ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_TRANSLATOR_ORIGIN_TRIAL_TOKEN=
ARG NEXT_PUBLIC_LANGUAGE_DETECTOR_ORIGIN_TRIAL_TOKEN=

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_TRANSLATOR_ORIGIN_TRIAL_TOKEN=$NEXT_PUBLIC_TRANSLATOR_ORIGIN_TRIAL_TOKEN
ENV NEXT_PUBLIC_LANGUAGE_DETECTOR_ORIGIN_TRIAL_TOKEN=$NEXT_PUBLIC_LANGUAGE_DETECTOR_ORIGIN_TRIAL_TOKEN
ENV API_PROXY_TARGET=http://api:8000
ENV RUNTIME_PROXY_TARGET=http://runtime:7860

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
