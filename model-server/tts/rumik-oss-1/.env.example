# This folder's own knobs, for reference.
#
# SETTING THEM HERE DOES NOTHING. Unlike the checkpoint's upstream
# docker-compose.yml, which passed its .env straight into the container with
# `env_file:`, this folder is a slot model: the file Compose reads is
# model-server/.env, and a variable only reaches the container because
# compose.extra.yml names it. So configure a deployment in model-server/.env
# (every key is documented in model-server/.env.example) and treat this file as
# the list of what exists.
#
# Defaults below are the compose defaults. See compose.extra.yml for why each
# one is what it is.

# --- engine -------------------------------------------------------------------
# vllm (default) or transformers. See the folder README for the parity check.
RUMIK_ENGINE=vllm
RUMIK_MAX_MODEL_LEN=8192
# Fraction of the card's TOTAL memory, reserved at startup and held.
RUMIK_GPU_MEMORY_UTILIZATION=0.12
RUMIK_MAX_NUM_SEQS=64
RUMIK_ENFORCE_EAGER=false

# --- model --------------------------------------------------------------------
RUMIK_MODEL_PATH=/models/rumik-oss-1
RUMIK_MODEL_NAME=rumik-oss-1
RUMIK_DEVICE=cuda
RUMIK_DTYPE=bfloat16
RUMIK_ATTN_IMPLEMENTATION=sdpa

# --- capacity -----------------------------------------------------------------
# No continuous batching, and measured at RTF ~2.2 for a SINGLE stream, so
# this is a real ceiling, not a hint. Raise only with an X-RTF under 1.0.
RUMIK_MAX_CONCURRENCY=1
RUMIK_MAX_INPUT_CHARS=1000

# --- server -------------------------------------------------------------------
# The port comes from PORT, set by the slot. There is no RUMIK_PORT on purpose.
RUMIK_HOST=0.0.0.0
RUMIK_LOG_LEVEL=INFO
RUMIK_CORS_ORIGINS=

# --- synthesis ----------------------------------------------------------------
RUMIK_DEFAULT_VOICE=Ira
RUMIK_DEFAULT_INSTRUCTIONS=
RUMIK_TEMPERATURE=0.8
RUMIK_TOP_K=30
RUMIK_MIN_NEW_TOKENS=8
RUMIK_MAX_NEW_TOKENS_DEFAULT=2048
RUMIK_MAX_NEW_TOKENS_LIMIT=2048

# --- streaming decode ---------------------------------------------------------
RUMIK_DECODE_CHUNK_FRAMES=2
RUMIK_DECODE_CONTEXT_FRAMES=32
RUMIK_DECODER_DEVICE=cuda

# --- warmup -------------------------------------------------------------------
RUMIK_WARMUP_ENABLED=true
RUMIK_WARMUP_TOKENS=256

# --- fetch.sh only ------------------------------------------------------------
# Read by fetch.sh on the host, not by the container.
# RUMIK_MODELS_DIR=./tts/rumik-oss-1/models
# RUMIK_REPO=rumik-ai/rumik-oss-1
# RUMIK_MODEL_DIRNAME=rumik-oss-1
