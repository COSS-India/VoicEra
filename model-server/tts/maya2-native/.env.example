# This folder's own knobs, for reference.
#
# SETTING THEM HERE DOES NOTHING. This is a slot model: the file Compose reads is
# model-server/.env, and a variable reaches the container only because
# compose.extra.yml names it. Configure a deployment in model-server/.env (every
# key is documented in model-server/.env.example) and treat this file as the
# list of what exists. Values below are the compose defaults.

# --- model --------------------------------------------------------------------
MAYA_MODEL_PATH=/models/maya2-native
MAYA_MIMI_DIR=/models/mimi
MAYA_ECAPA_DIR=/models/ecapa
MAYA_MODEL_NAME=maya2-native
MAYA_DEVICE=cuda

# --- engine -------------------------------------------------------------------
# GPU memory is allocated per seat at startup: ~7.7 GB at 1, 11.7 at 16, 15.8 at 32.
MAYA_MAX_SEATS=16
MAYA_CAPACITY=2048
MAYA_DEPTH_DTYPE=fp16

# --- admission ----------------------------------------------------------------
# 0 = same as MAYA_MAX_SEATS
MAYA_MAX_PENDING=0
MAYA_QUEUE_DEADLINE_MS=2000
MAYA_HTTP_MAX_LAG_S=120

# --- requests -----------------------------------------------------------------
MAYA_DEFAULT_VOICE=Ahana
MAYA_DEFAULT_FORMAT=pcm
MAYA_NORMALISE=true
MAYA_VOICE_CLONING=false

# --- server -------------------------------------------------------------------
# The port comes from PORT, set by the slot. There is no MAYA_PORT on purpose.
MAYA_HOST=0.0.0.0
MAYA_LOG_LEVEL=INFO

# --- fetch.sh only ------------------------------------------------------------
# Read by fetch.sh on the host, not by the container.
# MAYA_MODELS_DIR=./tts/maya2-native/models
# MAYA_REPO=maya-research/maya2-native
# MAYA_REVISION=main
