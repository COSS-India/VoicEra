# LID slot (nemotron-lid)
LID_MODEL=nemotron-lid
# Add lid to COMPOSE_PROFILES alongside stt/tts as needed, e.g.:
# COMPOSE_PROFILES=stt,tts,lid

LID_DEVICE=cuda
LID_NEMO_PATH=/models/indic_nemotron_v1_1_sft_600k_lr1-averaged-40k.nemo
# Directory that contains the .nemo as a real file (not a host symlink).
# Option A — download into this slot:
#   sh lid/nemotron-lid/fetch.sh
#   LID_MODELS_DIR=./lid/nemotron-lid/models
# Option B — reuse the same weights as indic-nemotron STT:
#   LID_MODELS_DIR=./stt/indic-nemotron/models/indic-asr-nemotron-600m
LID_MODELS_DIR=./lid/nemotron-lid/models
# Optional: LID_HF_TOKEN=hf_...
