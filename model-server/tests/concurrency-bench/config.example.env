# Concurrency bench settings. Copy to config.env and edit:
#     cp config.example.env config.env
# run.sh reads config.env (or the file named by $CONFIG). Every value can also be
# overridden on the command line, e.g.  LEVELS=1,2,4 ./run.sh tts

# ---- Where the servers are -----------------------------------------------------
# Through the model-server gateway both models share one base URL. To hit a model
# container directly instead, set its own URL and health path (see README).
STT_URL=http://127.0.0.1:8100
STT_HEALTH_PATH=/stt/health          # /health when pointing at the STT container
TTS_URL=http://127.0.0.1:8100        # also used by `run.sh corpus` to synthesise clips
TTS_HEALTH_PATH=/tts/health

# ---- Language and voices ---------------------------------------------------------
LANGUAGE=mr                          # needs prompts/<LANGUAGE>.json for synth / default text
CORPUS_VOICES=Anagha,Chinmay         # voices used to synthesise STT clips (empty = first two)
TTS_VOICE=                           # voice for the TTS test (empty = first in roster)
TTS_LENGTH=medium                    # short | medium | long sentence from the prompts file

# ---- STT corpus --------------------------------------------------------------------
CORPUS_DIR=corpus/$LANGUAGE          # manifest.json + clips/ live here
STT_BUCKET=medium                    # clip length streamed by every STT request
# Bring your own recordings instead of synthesising (see README):
# IMPORT_WAV_DIR=my_clips
# IMPORT_TRANSCRIPTS=my_clips/transcripts.csv

# ---- Test plan ------------------------------------------------------------------------
LEVELS=1,2,4,8,16,32,64,128,256
ROUNDS=3
ARRIVAL_WINDOW_S=1.0
MODE=both                            # sync (Test A) | random (Test B) | both
SEED=1234

# ---- Warm-up (discarded) ----------------------------------------------------------------
WARMUP_SINGLES=5
WARMUP_BATCHES=8,64,256
WARMUP_BUDGET_S=600

# ---- Pass rule --------------------------------------------------------------------------
PASS_PERCENTILE=p95
PASS_RTF=1.0

# ---- Optional ---------------------------------------------------------------------------
GPU_INDEX=                           # set only if this client runs on the GPU host
RUNAWAY_N=200                        # requests for `run.sh runaway`
RESULTS_ROOT=results
