# indic-nemotron. Copy what you want to change into model-server/.env.
#
# Every value has a default in compose.extra.yml, so an empty .env is a working
# deployment. A commented line here changes nothing -- it is documentation.

STT_MODEL=indic-nemotron

# ---- streaming latency ------------------------------------------------
# left,right attention context. 96,1 -> 160 ms | 96,3 -> 320 ms | 96,7 -> 640 ms.
# We declare 96,3. Upstream's CODE default is 96,7 and their compose (which we
# do not use) says 96,3 -- so leaving this unset would silently give 640 ms.
# NEMOTRON_ATT_CONTEXT=96,3

# ---- endpointing ------------------------------------------------------
# The server's own VAD finalises turns. With both this and the pipeline's VAD
# off, nothing ever finalises a transcript.
# NEMOTRON_VAD=0
# NEMOTRON_VAD_SILENCE_MS=400
# NEMOTRON_VAD_MARGIN_DB=2.5

# ---- batching ---------------------------------------------------------
# Raises throughput, and changes results: batched GPU kernels are not batch-size
# invariant and greedy RNNT amplifies the difference into visible transcript
# changes. A transcript can therefore differ under load.
# NEMOTRON_MAX_BATCH=128
# NEMOTRON_BATCH_WINDOW_MS=25
# NEMOTRON_MEL_WINDOW_MS=5

# ---- weights ----------------------------------------------------------
# Both gated; fetch.sh needs `huggingface-cli login` or HF_TOKEN.
# NEMOTRON_MODELS_DIR=./stt/indic-nemotron/models

# ---- diagnostics ------------------------------------------------------
# Writes raw mic captures to /app/debug, unbounded. This box has hit 100% disk
# three times; leave it off unless you are actively chasing an audio bug.
# NEMOTRON_DEBUG_CAPTURE=0
