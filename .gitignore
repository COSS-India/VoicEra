__pycache__/
fixtures/
.env
.env.local
.env.prod
.venv/
venv/
*.pyc
.DS_Store

# Internal docs working notes (style contract, code findings)
.docs-meta/

# Local agent skills, not part of the project
.agents/
.claude/
skills-lock.json

# Subagent-driven-development scratch workspace (ledgers, briefs, reports)
.superpowers/

# Runtime state from model-server/run/ -- pid files and logs are rewritten on
# every start, so every developer's copy differs and each pull conflicts. These
# rules existed and were dropped when dev merged into modelserver; the files are
# still produced, so without them the next `git add -A` commits a stale PID and
# a log carrying a developer's absolute home path and a NeMo traceback.
model-server/run/
*.pid
*.log

# Test fixtures create this beside the model they stub and clean it up on
# teardown; a run that dies before teardown leaves it behind.
_test_stub.nemo

# Empty stand-in for the `nemo` build context, created by
# start-model-server.sh when the selected STT model does not need the fork.
model-server/.nemo-context/

# Working folder created by the Claude desktop app, not part of the project.
Claude outputs/

# Generated protobuf stubs. Built at image build time and in the test fixture,
# never committed: generated code checked in beside a .proto drifts from it and
# nothing notices.
